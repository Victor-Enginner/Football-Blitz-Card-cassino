{
  "manifest_version": 3,
  "name": "Blitz — captura somente leitura",
  "version": "1.0.0",
  "description": "Registra rodadas visíveis no ledger local. Não clica nem aposta.",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://client.pragmaticplaylive.net/*", "https://games.pragmaticplaylive.net/*"],
    "all_frames": true,
    "run_at": "document_idle",
    "js": ["capture.js"]
  }]
}
