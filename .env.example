# .env.example — Football Blitz Command Center (sem segredos)
# Copie para .env e preencha apenas o que precisar.

# ── OmniRoute (primário) ──────────────────────────────
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_MODEL=auto
OMNIROUTE_TIMEOUT_S=60
# OMNIROUTE_API_KEY=   # só se o gateway exigir (REQUIRE_API_KEY=true)

# ── TokenRouter (free tier, fallback 2) ───────────────
TOKENROUTER_ENABLED=true
TOKENROUTER_BASE_URL=https://api.tokenrouter.com
TOKENROUTER_MODEL=z-ai/glm-5.3-free
# TOKENROUTER_API_KEY=   # tokenrouter.com → API keys

# ── NVIDIA NIM (free tier, fallback 3) ────────────────
NVIDIA_ENABLED=true
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_KEY=        # build.nvidia.com → Get API Key (free)

# ── AIsa (verified provider, fallback 4) ──────────────
AISA_ENABLED=true
AISA_BASE_URL=https://api.aisa.one
AISA_MODEL=claude-haiku-4-5-20251001
# AISA_API_KEY=

# ── Hermes agent (CLI 24/7) ───────────────────────────
# HERMES_ENDPOINT=       # ex.: https://api.tokenrouter.com/v1

# ── Slot genérico (9route ou outro endpoint OpenAI-compatible) ──
GENERIC_PROVIDER_ENABLED=false
GENERIC_PROVIDER_BASE_URL=
GENERIC_PROVIDER_MODEL=
GENERIC_PROVIDER_API_KEY=
GENERIC_PROVIDER_NAME=generic-slot

# ── Compressão ────────────────────────────────────────
FB_COMPRESSION=true
FB_COMPRESSION_TARGET=0.55
FB_COMPRESSION_MIN_CHARS=400

# ── Travas de segurança (todas bloqueantes) ───────────
FB_MAX_EVENTS_PER_DAY=200
FB_STOP_LOSS=75.0
FB_STOP_WIN=0.0
FB_MAX_SESSION_MINUTES=60
FB_COOLDOWN_MINUTES=30
FB_HOT_STREAK=10

# ── Comportamento ─────────────────────────────────────
FB_AI_COPILOT=true
FB_MAX_HYPOTHESES=50
